{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@extracker/types": ["packages/shared-types/src/index.ts"],
      "@extracker/core": ["packages/core/src/index.ts"],
      "@extracker/db": ["packages/db/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "out", "build"]
}
