# ═══════════════════════════════════════════════════════════════════
#  ExtraTracker — environment variables
#  Copy to .env.local for local dev. In production these are set on the
#  Railway service (see implementation.md). NEVER commit real secrets.
# ═══════════════════════════════════════════════════════════════════

# ─── Database (Prisma) ──────────────────────────────────────
# Local dev: the Postgres container from docker-compose.dev.yml
#   (start with: docker compose -f docker-compose.dev.yml up -d db)
# Railway: set BOTH to the reference ${{Postgres.DATABASE_URL}} (single
# instance, no pgbouncer — DIRECT_URL is required by prisma/schema.prisma
# and is used for `prisma migrate deploy`).
DATABASE_URL=postgresql://extracker:extracker@localhost:5433/extracker
DIRECT_URL=postgresql://extracker:extracker@localhost:5433/extracker

# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=production
# PORT is provided by Railway automatically — do NOT hardcode it in production.
# PORT=3000

# ─── Auth.js ────────────────────────────────────────────────
AUTH_SECRET=your-auth-secret-here              # Generate: openssl rand -base64 32
# Base URL of the app. Auth.js v5 uses AUTH_URL; NEXTAUTH_URL kept for compat.
# In production set BOTH to your real origin (the Railway domain), e.g.
# https://extracker-production.up.railway.app  — must match scheme + host.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth ───────────────────────────────────────────
# Add these redirect URIs in Google Cloud Console (no trailing slash):
#   http://localhost:3000/api/auth/callback/google
#   https://<PRODUCTION_DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Email Service (Resend) ─────────────────────────────────
RESEND_API_KEY=re_your_api_key_here            # Optional: emails logged to console if unset

# ─── Cron Job Security (Production) ─────────────────────────
CRON_SECRET=your-cron-secret-here              # Generate: openssl rand -base64 32

# ─── Web Push (PWA notifications) — all optional ────────────
# If unset, web push is a no-op (in-app + email still work).
VAPID_PUBLIC_KEY=your-vapid-public-key         # Generate: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=your-vapid-private-key        # Keep secret (server-only)
VAPID_SUBJECT=mailto:you@example.com            # Contact URI required by the Web Push spec
# Build-time / client-inlined. Must equal VAPID_PUBLIC_KEY. In CI it is passed
# as a Docker build-arg (repo Variable NEXT_PUBLIC_VAPID_PUBLIC_KEY).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
