// Prisma schema for ExtraTracker - minimal accurate models for expenses and payments
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Models

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  password       String?   // Hashed password for email/password auth (nullable for OAuth-only users)
  hasSetPassword Boolean   @default(false) // Track if user has set a password
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  expenses       Expense[]
  categories     Category[]
  paymentCards   PaymentCard[]
  notifications  Notification[]
  notificationPreferences NotificationPreference?
  pushSubscriptions PushSubscription[]
  accounts       Account[]
  sessions       Session[]
  transactions   Transaction[]
  incomeSources  IncomeSource[]
  debts          Debt[]
  goals          Goal[]
  refreshTokens  RefreshToken[]
}

// Legacy table from an earlier auth implementation; still present on the live
// DB, so it is modeled here to keep the schema and migration history in sync.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// Unified ledger (Phase 1): every money movement is a Transaction.
// Fixed recurring bills stay in Expense/Payment; markPaid mirrors them here.

enum TransactionType {
  INCOME
  EXPENSE
}

enum EntrySource {
  MANUAL
  AUTO // stable-income monthly accrual
  CLAUDE
  IMPORT
  BANK
}

enum IncomeType {
  STABLE   // salary — fixed amount and day
  VARIABLE // projects, one-off
}

model Transaction {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @db.Uuid
  type           TransactionType
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("GEL")
  date           DateTime        // when it actually happened
  categoryId     String?         @db.Uuid // for EXPENSE
  incomeSourceId String?         @db.Uuid // for INCOME
  expenseId      String?         @db.Uuid // link to fixed Expense when created via markPaid
  description    String?
  entrySource    EntrySource     @default(MANUAL)
  externalId     String?         // bank transaction ID — Phase 6 dedup; null for now
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  incomeSource IncomeSource? @relation(fields: [incomeSourceId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, type, date])
  @@unique([userId, externalId]) // dedup in Phase 6
}

model IncomeSource {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  name           String     // "ხელფასი", "Freelance — X"
  type           IncomeType
  expectedAmount Decimal?   @db.Decimal(12, 2) // required for STABLE
  currency       String     @default("GEL")
  expectedDay    Int?       // day of month, for STABLE
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

// Debts (Phase 2): full annuity amortization + prepayment simulator.
// The schedule is generated once and stored (not computed on the fly) so paid
// history stays immutable; prepayment regenerates only the unpaid tail.

enum DebtStatus {
  ACTIVE
  PAID_OFF
  ARCHIVED
}

model Debt {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @db.Uuid
  name             String // "სამომხმარებლო სესხი — TBC"
  principal        Decimal    @db.Decimal(12, 2) // starting principal
  annualRatePct    Decimal    @db.Decimal(6, 3) // annual % (e.g. 18.500)
  termMonths       Int // months (computed when monthlyPayment was the input)
  monthlyPayment   Decimal    @db.Decimal(12, 2) // annuity payment (computed when termMonths was the input)
  currency         String     @default("GEL")
  firstPaymentDate DateTime // first installment; the rest fall on the same day monthly
  status           DebtStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule DebtScheduleItem[]

  @@index([userId, status])
}

model DebtScheduleItem {
  id                 String    @id @default(uuid()) @db.Uuid
  debtId             String    @db.Uuid
  seq                Int // 1..termMonths
  dueDate            DateTime
  payment            Decimal   @db.Decimal(12, 2)
  interestPart       Decimal   @db.Decimal(12, 2)
  principalPart      Decimal   @db.Decimal(12, 2)
  remainingPrincipal Decimal   @db.Decimal(12, 2) // after this installment
  paid               Boolean   @default(false)
  paidAt             DateTime?
  paidAmount         Decimal?  @db.Decimal(12, 2) // actual (≠ payment on prepayment)
  transactionId      String?   @db.Uuid // loose link to the ledger

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@unique([debtId, seq])
  @@index([debtId, paid, dueDate])
}

// Goals & emergency fund (Phase 3, PRD §7.4 / R1 / D5 / G3-G4).
// A goal is name + target + optional date/monthly-contribution + priority.
// The emergency fund is a system goal: auto-created, undeletable, always
// priority #1, with a target the system derives from mandatory expenses.

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  ARCHIVED
}

model Goal {
  id                  String     @id @default(uuid()) @db.Uuid
  userId              String     @db.Uuid
  name                String
  targetAmount        Decimal    @db.Decimal(12, 2) // for the reserve — auto-computed, cached
  currency            String     @default("GEL")
  targetDate          DateTime?  // desired date (optional — then derived from contribution)
  monthlyContribution Decimal?   @db.Decimal(12, 2) // planned contribution (optional — then derived from date)
  priority            Int        // 1 = highest; reserve is always 1, others 2+
  status              GoalStatus @default(ACTIVE)
  isEmergencyFund     Boolean    @default(false) // system goal: cannot be deleted, priority is fixed
  reserveStage        Int?       // for the reserve: 1 (= 1 month) or 3 (= 3 months)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId, status, priority])
}

model GoalContribution {
  id            String   @id @default(uuid()) @db.Uuid
  goalId        String   @db.Uuid
  amount        Decimal  @db.Decimal(12, 2) // positive = contribution, negative = withdrawal
  date          DateTime
  reason        String?  // required on withdrawal
  transactionId String?  @db.Uuid // link to the ledger
  createdAt     DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  token     String   @unique // 6-digit code
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  token     String   @unique // 6-digit code
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model Expense {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  paymentCardId String?   @db.Uuid
  title         String
  amount        Decimal   @db.Decimal(12, 2)
  currency      String    @default("GEL")
  description   String?
  category      String?
  icon          String?   // Brand/category logo slug (e.g. "spotify", "anthropic")
  isRecurring   Boolean   @default(false)
  recurrenceRule String?  // e.g., "RRULE:FREQ=MONTHLY;INTERVAL=1"
  startDate     DateTime?
  nextDueDate   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentCard   PaymentCard? @relation(fields: [paymentCardId], references: [id], onDelete: SetNull)
  payments      Payment[]
}

model Payment {
  id           String    @id @default(uuid()) @db.Uuid
  expenseId    String    @db.Uuid
  dueDate      DateTime
  amount       Decimal   @db.Decimal(12, 2)
  paid         Boolean   @default(false)
  paidAt       DateTime?
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  expense      Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid @unique
  emailEnabled  Boolean  @default(true)
  smsEnabled    Boolean  @default(false)
  pushEnabled   Boolean  @default(false)
  // days before due to notify
  notifyBeforeDays Int   @default(3)
  // UI preferences
  theme         String   @default("light") // 'light', 'dark', 'system'
  defaultCurrency String @default("GEL") // 'GEL', 'USD', 'EUR'
  // Subscription
  subscriptionPlan String @default("free") // 'free', 'pro', 'enterprise'
  subscriptionStatus String @default("active") // 'active', 'canceled', 'expired'

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique // Browser push endpoint URL (unique per device/browser)
  p256dh    String   // Client public key for payload encryption
  auth      String   // Client auth secret for payload encryption
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // Optimize lookups when sending to a user's devices
}

model Category {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  categoryName  String
  color         String   @default("#3b82f6") // Default blue color
  kind          String   @default("VARIABLE") // "FIXED" | "VARIABLE"
  monthlyLimit  Decimal? @db.Decimal(12, 2)   // soft target; null = no limit
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([userId, categoryName]) // Prevent duplicate category names per user
  @@index([userId]) // Optimize queries by userId
}

model PaymentCard {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  cardholderName  String
  lastFourDigits  String    // Only store last 4 digits for security
  expiryMonth     Int       // 1-12
  expiryYear      Int       // e.g., 2025
  cardBrand       String    // Visa, Mastercard, Amex, Discover
  nickname        String?   // Optional friendly name like "Personal Card"
  color           String    @default("#1e40af") // Card UI background color
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses        Expense[]

  @@index([userId]) // Optimize queries by userId
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  title       String
  message     String
  type        String    @default("info") // 'info', 'success', 'warning', 'error', 'payment', 'expense'
  isRead      Boolean   @default(false)
  actionUrl   String?   // Optional URL for the notification action
  metadata    String?   // JSON string for additional data
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead]) // Optimize queries by userId and read status
  @@index([createdAt]) // Optimize sorting by date
}
