// Prisma schema for ExtraTracker - minimal accurate models for expenses and payments
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Models

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  password       String?   // Hashed password for email/password auth (nullable for OAuth-only users)
  hasSetPassword Boolean   @default(false) // Track if user has set a password
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  expenses       Expense[]
  categories     Category[]
  paymentCards   PaymentCard[]
  notifications  Notification[]
  notificationPreferences NotificationPreference?
  pushSubscriptions PushSubscription[]
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  token     String   @unique // 6-digit code
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model Expense {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  paymentCardId String?   @db.Uuid
  title         String
  amount        Decimal   @db.Decimal(12, 2)
  currency      String    @default("GEL")
  description   String?
  category      String?
  isRecurring   Boolean   @default(false)
  recurrenceRule String?  // e.g., "RRULE:FREQ=MONTHLY;INTERVAL=1"
  startDate     DateTime?
  nextDueDate   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentCard   PaymentCard? @relation(fields: [paymentCardId], references: [id], onDelete: SetNull)
  payments      Payment[]
}

model Payment {
  id           String    @id @default(uuid()) @db.Uuid
  expenseId    String    @db.Uuid
  dueDate      DateTime
  amount       Decimal   @db.Decimal(12, 2)
  paid         Boolean   @default(false)
  paidAt       DateTime?
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  expense      Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid @unique
  emailEnabled  Boolean  @default(true)
  smsEnabled    Boolean  @default(false)
  pushEnabled   Boolean  @default(false)
  // days before due to notify
  notifyBeforeDays Int   @default(3)
  // UI preferences
  theme         String   @default("light") // 'light', 'dark', 'system'
  defaultCurrency String @default("GEL") // 'GEL', 'USD', 'EUR'
  // Subscription
  subscriptionPlan String @default("free") // 'free', 'pro', 'enterprise'
  subscriptionStatus String @default("active") // 'active', 'canceled', 'expired'

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique // Browser push endpoint URL (unique per device/browser)
  p256dh    String   // Client public key for payload encryption
  auth      String   // Client auth secret for payload encryption
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // Optimize lookups when sending to a user's devices
}

model Category {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  categoryName  String
  color         String   @default("#3b82f6") // Default blue color
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryName]) // Prevent duplicate category names per user
  @@index([userId]) // Optimize queries by userId
}

model PaymentCard {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  cardholderName  String
  lastFourDigits  String    // Only store last 4 digits for security
  expiryMonth     Int       // 1-12
  expiryYear      Int       // e.g., 2025
  cardBrand       String    // Visa, Mastercard, Amex, Discover
  nickname        String?   // Optional friendly name like "Personal Card"
  color           String    @default("#1e40af") // Card UI background color
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses        Expense[]

  @@index([userId]) // Optimize queries by userId
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  title       String
  message     String
  type        String    @default("info") // 'info', 'success', 'warning', 'error', 'payment', 'expense'
  isRead      Boolean   @default(false)
  actionUrl   String?   // Optional URL for the notification action
  metadata    String?   // JSON string for additional data
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead]) // Optimize queries by userId and read status
  @@index([createdAt]) // Optimize sorting by date
}
