{
  "name": "extracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:test": "dotenv -e .env.local -- tsx scripts/test-db-connection.ts",
