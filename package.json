{
  "name": "extracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "nx run web:dev",
    "build": "nx run web:build",
    "start": "nx run web:start",
    "lint": "nx run web:lint",
    "db:test": "nx run @extracker/db:db:test",
    "db:verify": "nx run web:db:verify",
    "prisma:generate": "nx run @extracker/db:prisma:generate",
    "prisma:push": "nx run @extracker/db:prisma:push",
    "prisma:studio": "nx run @extracker/db:prisma:studio",
    "prisma:seed": "nx run @extracker/db:prisma:seed",
    "seed:notifications": "nx run web:seed:notifications",
    "api:dev": "nx run api:dev",
    "api:build": "nx run api:build",
    "api:start": "nx run api:start",
    "mobile:start": "nx run mobile:start",
    "mobile:android": "nx run mobile:android",
    "mobile:ios": "nx run mobile:ios"
  },
  "devDependencies": {
    "nx": "^20.4.0",
    "@nx/next": "^20.4.0",
    "@nx/workspace": "^20.4.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowAny": [
        "react",
        "react-dom"
      ]
    }
  }
}
