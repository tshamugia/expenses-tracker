{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter api run dev" }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "^prisma:generate"],
      "options": { "command": "pnpm --filter api run build" },
      "cache": true
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter api run start" }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^prisma:generate"],
      "options": { "command": "pnpm --filter api run test" }
    }
  }
}
