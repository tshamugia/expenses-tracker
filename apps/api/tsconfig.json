{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["bun-types"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@extracker/types": ["../../packages/shared-types/src/index.ts"],
      "@extracker/core": ["../../packages/core/src/index.ts"],
      "@extracker/db": ["../../packages/db/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
